# La base es el Postgres del proyecto de Supabase.
# Supabase → Project Settings → Database → Connection string
#
# En Vercel usá la cadena del POOLER en modo transacción (puerto 6543):
#   postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres
# En tu máquina o en un servidor propio sirve la conexión directa (puerto 5432):
#   postgresql://postgres:CLAVE@db.PROYECTO.supabase.co:5432/postgres
DATABASE_URL=

# Cuántas conexiones abre cada instancia. Si no se define: 3 en Vercel, 10 fuera.
# DB_MAX_CONEXIONES=3

# Base APARTE para las pruebas. Las pruebas hacen truncate: si esto apunta a la
# base de trabajo, se lleva puesta la cartera. Sin esta variable, las pruebas
# que escriben en la base se saltean solas.
DATABASE_URL_PRUEBAS=

# La clave de Anthropic, para lo que usa el modelo (preguntar, diagnóstico).
# Sin esta clave el resto de la aplicación anda igual.
ANTHROPIC_API_KEY=

# Sólo si la clave NO está asignada a un workspace. Si la creaste desde adentro
# de un workspace en console.anthropic.com, dejá esto vacío.
ANTHROPIC_WORKSPACE_ID=
